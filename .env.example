# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=task_managing_system_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend (Rails) ---
RAILS_ENV=development
# Connection details the Rails container uses to reach the db service.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=task_managing_system_development
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Generate with: bin/rails secret  (any long random string works for local dev)
SECRET_KEY_BASE=replace_me_with_a_long_random_value
RAILS_MAX_THREADS=5
# Comma-separated extra origins allowed via CORS (blank in the proxied setup).
CORS_ORIGINS=

# --- SMTP (email verification) ---
# In development, mail is captured by letter_opener_web (view at
# http://localhost:8080/letter_opener) — no SMTP server needed.
# For real delivery (production), set the spec-required relay:
SMTP_ADDRESS=relay1.dataart.com
SMTP_PORT=25
SMTP_DOMAIN=dataart.com
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
# Base URL used to build verification links in emails.
APP_BASE_URL=http://localhost:8080

# --- Swagger UI (/api-docs) ---
# API docs require HTTP Basic auth whenever these are set (and always in
# production, fail-closed if unset). docker-compose defaults to docs/docs in dev
# so the docs are protected out of the box; override here, or clear both to open
# docs in development.
SWAGGER_USER=docs
SWAGGER_PASSWORD=docs

# --- Ports exposed on the host ---
WEB_PORT=8080
